# ── Email (SMTP) ──────────────────────────────────────────────
# Set all four vars below to enable real email delivery.
# Until they are set, the system logs emails to the backend console.
#
# Gmail example (requires a Gmail App Password — NOT your account password):
#   1. Enable 2-Step Verification on your Google account
#   2. Go to myaccount.google.com/apppasswords
#   3. Create an App Password for "Mail"
#   4. Use that 16-character App Password as SMTP_PASS
#
# Outlook/Hotmail example:
#   SMTP_HOST=smtp-mail.outlook.com
#   SMTP_PORT=587
#   SMTP_USER=your.address@outlook.com
#   SMTP_PASS=your-password
#
# Any valid email address is accepted — @gmail.com, @outlook.com, etc.
# The address does NOT have to end in @nbi or any institutional domain.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=oyedelebukola810@gmail.com
SMTP_PASS=yvdp nzql dleg byfe
SMTP_FROM="NBI Institute" <oyedelebukola810@gmail.com>
